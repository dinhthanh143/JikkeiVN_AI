DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres
SECRET_KEY=your-256-bit-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=

# ── AI: Dialogue + Embeddings — Direct providers (main) ───────────────────────────
# GOOGLE_AI_STUDIO_API_KEY: direct Gemini call for all dialogue turns (main).
# NVIDIA_API_KEY: direct embedding call for all lore writes/searches (main).
# Both fall back to OpenRouter automatically if their direct call fails.
OPENAI_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
NVIDIA_API_KEY=

# ── AI: Dialogue / Summarisation / Premium Fallback (OpenRouter — fallback only) ────
# OpenRouter API key for all LLM requests.
OPENROUTER_API_KEY=

# Model routing (all accessed through OpenRouter).
OPENROUTER_DIALOGUE_MODEL=google/gemini-2.5-flash
OPENROUTER_SUMMARISATION_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SUMMARISATION_FALLBACK_MODEL=qwen/qwen-2.5-7b-instruct:free
OPENROUTER_BUDGET_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=1

# Embedding models (also via OpenRouter). Both truncated to 768-dim via the
# `dimensions` param at request time to match the lore_chunks.embedding column.
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2:free
OPENROUTER_EMBEDDING_FALLBACK_MODEL=qwen/qwen3-embedding-8b

# ── Cloudinary ───────────────────────────────────────────────────────────
# Cloudinary account cloud name.
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key for authenticated media operations.
CLOUDINARY_API_KEY=
# Cloudinary API secret for signed upload/signature generation.
CLOUDINARY_API_SECRET=

# ── Cost Safety Caps ─────────────────────────────────────────────────────
# Max total free-tier turns allowed by product policy.
MAX_TURNS_FREE_TIER=100
# Max turns allowed in a single scene session.
MAX_TURNS_PER_SESSION=50
# Rolling credit window. Premium changes this allowance, not the AI model.
CREDIT_WINDOW_HOURS=5
SESSION_CREDITS_FREE=20
SESSION_CREDITS_PREMIUM=80
TURN_CLAIM_TTL_SECONDS=300
# Maximum allowed upload size in MB.
MAX_UPLOAD_SIZE_MB=5
# Comma-separated MIME allowlist for image uploads.
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

REDIS_URL=redis://localhost:6379
RATELIMIT_STORAGE_URL=memory://
# Production option: RATELIMIT_STORAGE_URL=redis://localhost:6379
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_AI_CHAT=10/minute
LEGAL_VERSION=v1.0

DAILY_COIN_AMOUNT=20

# ── Stripe billing ─────────────────────────────────────────────────────────
# Secret key from https://dashboard.stripe.com/test/apikeys (sk_test_... in dev)
STRIPE_SECRET_KEY=
# Webhook signing secret. Locally: `stripe listen --forward-to localhost:8000/billing/webhook`
# prints one. In production, set from the registered webhook endpoint in the Dashboard.
STRIPE_WEBHOOK_SECRET=
# Price ID for the premium monthly subscription (see app/core/billing.py PRICE_MAP)
STRIPE_PRICE_PREMIUM_MONTHLY=
