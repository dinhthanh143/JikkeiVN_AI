{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Codegraph: Watch",
      "type": "shell",
      "command": "npx",
      "args": ["-y", "@optave/codegraph", "watch", "."],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Jikkei: Frontend Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/jikkei"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Jikkei: Backend Dev",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "options": {
        "cwd": "${workspaceFolder}/jikkei-api"
      },
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      }
    },
    {
      "label": "Jikkei: Dev Stack",
      "dependsOn": [
        "Jikkei: Frontend Dev",
        "Jikkei: Backend Dev",
        "Codegraph: Watch"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Git: Pull",
      "type": "shell",
      "command": "git",
      "args": ["pull"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Git: Push",
      "type": "shell",
      "command": "git",
      "args": ["push"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Git: Sync",
      "dependsOn": ["Git: Pull", "Git: Push"],
      "dependsOrder": "sequence", // pull first, then push
      "problemMatcher": []
    },
    {
      "label": "Git: Status",
      "type": "shell",
      "command": "git",
      "args": ["status"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Git: Commit",
      "type": "shell",
      // Windows (powershell) — change to bash if on Linux/Mac
      "command": "powershell",
      "args": [
        "-Command",
        "git add -A; $msg = Read-Host 'Commit message'; git commit -m $msg"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    },
   
     {
          "label": "Stripe: Listen for webhooks",
          "type": "shell",
          "command": "stripe",
          "args": ["listen", "--forward-to", "localhost:8000/billing/webhook"],
          "isBackground": true,
          "problemMatcher": [],
          "presentation": {
            "reveal": "always",
            "panel": "dedicated",
            "group": "stripe"
          },
          "runOptions": {
            "runOn": "default"
          }
        }
  ]
}
